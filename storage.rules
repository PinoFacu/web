rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin() {
      return request.auth != null
        && request.auth.uid == 'REEMPLAZAR_CON_UID_ADMIN';
    }

    match /remates/{allPaths=**} {
      allow read: if true;

      // Solo imágenes de menos de 4 MB, subidas por el administrador.
      allow create, update: if isAdmin()
        && request.resource.size < 4 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');

      allow delete: if isAdmin();
    }
  }
}
